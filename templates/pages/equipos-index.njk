{% extends "layout.njk" %}
{% block content %}
<div class="page-hero" data-reveal>
  <span class="badge">Equipos</span>
  <h1>Los 30 equipos de la NBA</h1>
  <div class="entity-meta">Conferencia, división y acceso a la ficha de cada franquicia.</div>
</div>

<div class="card" data-reveal>
  <div class="table-scroll">
    <table class="stat-table">
      <thead><tr><th>Equipo</th><th>Conferencia</th><th>División</th></tr></thead>
      <tbody>
        {% for team in teams %}
        <tr><td><a href="/equipos/{{ team.slug }}/index.html">{{ team.full_name }}</a></td><td>{{ team.conference }}</td><td>{{ team.division }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
