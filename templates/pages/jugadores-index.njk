{% extends "layout.njk" %}
{% block content %}
<div class="page-hero" data-reveal>
  <span class="badge">Jugadores</span>
  <h1>Jugadores NBA</h1>
  <div class="entity-meta">Plantillas completas de los 30 equipos, con acceso a la ficha de cada jugador.</div>
</div>

<div class="card" data-reveal>
  <div class="table-scroll">
    <table class="stat-table">
      <thead><tr><th>Jugador</th><th>Equipo</th><th>Pos</th></tr></thead>
      <tbody>
        {% for player in players %}
        <tr><td><a href="/jugadores/{{ player.slug }}/index.html">{{ player.full_name }}</a></td><td>{{ player.teamName or '—' }}</td><td>{{ player.position }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
