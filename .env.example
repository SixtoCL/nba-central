# Copia este archivo a .env y rellena tus claves reales. Nunca subas .env al repositorio.

# balldontlie.io - necesita plan GOAT (39,99$/mes) para stats, season_averages, standings y leaders.
# Con el plan gratis solo funcionan teams/players/games.
BALLDONTLIE_API_KEY=

# the-odds-api.com - plan Professional (29$/mes) para h2h/spreads/totals de NBA en Espana/Europa.
ODDS_API_KEY=
